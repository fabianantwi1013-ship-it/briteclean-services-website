# Copy to .env for local development, and set the same three in
# Vercel → Settings → Environment Variables for production.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender. The domain must be verified in Resend before this will send.
MAIL_FROM="Briteclean Services <bookings@britecleanservices.com>"

# Where booking requests and contact messages are delivered.
# Comma-separate for more than one recipient.
MAIL_TO=info@britecleanservices.com

# =============================================================================
# Briteclean Services LLC
#
# Astro static site + Vercel serverless functions.
# The wp-content/ tree is the superseded WordPress build, kept for history.
# =============================================================================

# --- Node / Astro / Vercel -------------------------------------------------
node_modules/
dist/
dist-wp/
.astro/
.vercel/
.output/
*.tsbuildinfo

# --- Secrets ----------------------------------------------------------------
# .env holds the Resend API key. Never commit it; .env.example documents the shape.
.env
.env.*
!.env.example
*.pem
*.key

# --- Customer data ----------------------------------------------------------
# Any exported booking data contains names, phone numbers, emails and home
# addresses. It must not go near version control.
briteclean-bookings-*.csv
*.sql
*.sql.gz
*.wpress

# --- Legacy WordPress: allowlist only our own code --------------------------
wp-content/*
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/briteclean/
!wp-content/plugins/
wp-content/plugins/*
!wp-content/plugins/briteclean-bookings/
wp-config.php

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
debug.log

# --- Editors and OS ---------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
.vscode/
.idea/
*.swp
*~
.claude/

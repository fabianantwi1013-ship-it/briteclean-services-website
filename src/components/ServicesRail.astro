---
/**
 * Services as a horizontal film strip. On wide screens the section pins and vertical
 * scrolling drives the strip sideways; on touch screens it is a native swipeable
 * row with scroll-snap. Either way every card is a real link in document order.
 */
import Icon from './Icon.astro';
import Img from './Img.astro';
import { services } from '../data/site.js';

const total = String(services.length).padStart(2, '0');
---

<section class="rail-section" id="services" data-rail>
  <div class="rail-section__pin" data-rail-pin>
    <div class="container rail-section__head">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 data-split>Our Cleaning Services</h2>
      </div>
      <p class="lead">Homes, offices and commercial spaces — booked around your schedule, cleaned to a standard you can see.</p>
    </div>

    <div class="rail" data-rail-viewport tabindex="-1">
      <ul class="rail__track" data-rail-track>
        {services.map((service, i) => {
          return (
            <li class="rail__item">
              <a class="svc-card" href={`/services#${service.slug}`} data-cursor="Explore">
                <div class="svc-card__media">
                  <div class="svc-card__img" data-rail-img>
                    <Img photo={`service-${service.slug}`} sizes="(min-width: 1024px) 30vw, 80vw" widths={[480, 720, 960, 1200]} alt="" />
                  </div>
                  <span class="svc-card__icon" aria-hidden="true"><Icon name={service.icon} size={22} /></span>
                </div>
                <div class="svc-card__body">
                  <span class="index">{String(i + 1).padStart(2, '0')} / {total}</span>
                  <h3>{service.name}</h3>
                  <p>{service.short}</p>
                  <span class="svc-card__more">
                    Learn more <Icon name="arrowUpRight" size={16} />
                  </span>
                </div>
              </a>
            </li>
          );
        })}
        <li class="rail__item rail__item--end">
          <div class="rail-end on-ink grain">
            <p class="eyebrow eyebrow--on-ink">Not sure which?</p>
            <p class="rail-end__title">Tell us about the space. <em>We will scope it with you.</em></p>
            <a class="btn btn--accent" href="/book-now">Book a Cleaning <span class="btn__icon"><Icon name="arrow" size={16} /></span></a>
          </div>
        </li>
      </ul>
    </div>

    <div class="container rail-section__foot">
      <p class="rail-section__hint index" aria-hidden="true">Scroll to explore</p>
      <div class="rail-progress" aria-hidden="true"><span data-rail-progress></span></div>
    </div>
  </div>
</section>

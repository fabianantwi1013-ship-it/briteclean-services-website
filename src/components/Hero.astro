---
/**
 * Homepage hero. Photos change with a diagonal wipe led by a glowing light-green
 * edge; each progress bar fills over six seconds and its animation ending is what
 * advances the slide, so pausing is exact. Only the first photo loads up front.
 * No autoplay under reduced motion; always pausable.
 */
import Icon from './Icon.astro';
import Img from './Img.astro';
import { hero, heroSlides, business, phoneDigits } from '../data/site.js';

// Same words as the brief, "Professional Cleaning Services for Your Space", with the
// last phrase picked out in colour.
const [lead, tail] = hero.headline.split(' for ');
---

<section class="hero" data-hero aria-label="Introduction">
  <div class="hero__slides" aria-hidden="true">
    {heroSlides.map((slide, i) => (
      <div class={`hero__slide${i === 0 ? ' is-active is-first' : ''}`} data-slide>
        <Img
          photo={slide.photo}
          alt=""
          eager={i === 0}
          lowPriority={i > 0}
          sizes="100vw"
          widths={[640, 960, 1280, 1920]}
          position={slide.position}
        />
      </div>
    ))}
    <span class="hero__edge" data-edge></span>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="hero__badge"><Icon name="sparkle" size={14} /> {hero.badge}</p>
    <h1 class="hero__title">{lead} <span>for {tail}</span></h1>
    <p class="hero__sub">{hero.subheadline}</p>
    <div class="btn-row hero__actions">
      <a class="btn btn--accent btn--lg" href="/book-now">{hero.ctaPrimary}</a>
      <a class="btn btn--outline-light btn--lg" href={`tel:+${phoneDigits(business.phonePrimary)}`}>
        <Icon name="phone" size={18} /> {hero.ctaSecondary}
      </a>
    </div>
  </div>

  <div class="container hero__controls" data-hero-controls hidden>
    <div class="hero__bars" data-bars>
      {heroSlides.map((_, i) => (
        <button type="button" class="hero__bar" data-dot={i} aria-label={`Show photo ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
    <button type="button" class="hero__pause" data-pause aria-label="Pause slideshow">
      <span class="hero__pause-icon"><Icon name="pause" size={14} /></span>
      <span class="hero__play-icon"><Icon name="play" size={12} /></span>
    </button>
  </div>
</section>

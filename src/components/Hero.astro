---
import Icon from './Icon.astro';
import { hero, business, phoneDigits } from '../data/site.js';
import alts from '../data/photo-alt.json';
---

<section class="bc-hero">
  <div class="bc-container bc-hero__grid">
    <div class="bc-hero__copy">
      <span class="bc-badge bc-hero__badge">
        <Icon name="sparkle" size={16} />
        {hero.badge}
      </span>

      <h1>{hero.headline}</h1>
      <p class="bc-hero__sub">{hero.subheadline}</p>

      <div class="bc-btn-row">
        <a class="bc-btn bc-btn--accent bc-btn--lg" href="/book-now">
          {hero.ctaPrimary}
          <Icon name="arrow" size={18} />
        </a>
        <a class="bc-btn bc-btn--ghost-light bc-btn--lg" href={`tel:+${phoneDigits(business.phonePrimary)}`}>
          <Icon name="phone" size={18} />
          {hero.ctaSecondary}
        </a>
      </div>

      <p class="bc-hero__tagline">{business.tagline}</p>
    </div>

    <div class="bc-hero__media">
      {/* Not lazy-loaded and given high priority: this is the LCP element. */}
      <img
        src={hero.image}
        alt={alts['hero-kitchen-counter.jpg']}
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <span class="bc-hero__float">
        <span class="bc-medallion bc-medallion--sm bc-medallion--green" aria-hidden="true">
          <Icon name="leaf" size={18} />
        </span>
        Eco-friendly products
      </span>
    </div>
  </div>
</section>

---
/**
 * How booking works. On wide screens the heading and a rolling step counter stay
 * pinned while the steps scroll past; a light-green line tracks progress.
 */
import Icon from './Icon.astro';
import { process } from '../data/site.js';

const icons = ['form', 'phone', 'sparkle', 'shield'];
const total = String(process.length).padStart(2, '0');
---

<section class="process section section--paper" id="how-it-works" data-process>
  <div class="container process__grid">
    <div class="process__aside">
      <div class="process__sticky">
        <p class="eyebrow">How it works</p>
        <h2 data-split>From request to <em>spotless</em> in four steps</h2>
        <div class="process__counter" aria-hidden="true">
          <span class="process__num-window"><span class="process__num-reel" data-process-reel>
            {process.map((_, i) => <span>{String(i + 1).padStart(2, '0')}</span>)}
          </span></span>
          <span class="process__total">/ {total}</span>
        </div>
      </div>
    </div>

    <div class="process__body">
      <span class="process__rail" aria-hidden="true"><span data-process-line></span></span>
      <ol class="process__steps">
      {process.map((step, i) => (
        <li class="process__step" data-process-step>
          <span class="process__icon" aria-hidden="true"><Icon name={icons[i]} size={26} /></span>
          <div>
            <p class="index">Step {String(i + 1).padStart(2, '0')}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

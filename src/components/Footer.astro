---
import Icon from './Icon.astro';
import TrustBadges from './TrustBadges.astro';
import { business, phoneDigits, hero } from '../data/site.js';

const socialIcons = { facebook: 'check', instagram: 'star', google: 'pin', yelp: 'heart' };
const socialLabels = { facebook: 'Facebook', instagram: 'Instagram', google: 'Google Business Profile', yelp: 'Yelp' };
const socials = Object.entries(business.social).filter(([, url]) => url);
const year = new Date().getFullYear();
---

<TrustBadges />

<footer class="bc-footer">
  <div class="bc-container">
    <div class="bc-footer__grid">
      <div>
        <h3 class="bc-footer__heading">{business.name}</h3>
        <p>{hero.subheadline}</p>
        <p class="bc-footer__tagline">{business.tagline}</p>
        {socials.length > 0 && (
          <div class="bc-social">
            {socials.map(([network, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer">
                <span class="screen-reader-text">{socialLabels[network]}</span>
                <Icon name={socialIcons[network]} size={18} />
              </a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h3 class="bc-footer__heading">Get in touch</h3>
        <ul>
          <li><a href={`tel:+${phoneDigits(business.phonePrimary)}`}>{business.phonePrimary}</a></li>
          <li><a href={`tel:+${phoneDigits(business.phoneSecondary)}`}>{business.phoneSecondary}</a></li>
          <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li>
            <address style="font-style:normal">
              {business.street}<br />
              {business.city}, {business.state} {business.postal}
            </address>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="bc-footer__heading">Explore</h3>
        <ul>
          <li><a href="/services">Services</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/book-now">Book Now</a></li>
        </ul>
      </div>

      <div>
        <h3 class="bc-footer__heading">Opening hours</h3>
        <dl class="bc-footer__hours">
          {business.hours.map((h) => (
            <div>
              <dt>{h.days}</dt>
              <dd>{h.time}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="bc-footer__bottom">
      <p>© {year} {business.name}. All rights reserved.</p>
      <p>{business.taglineSecondary}</p>
    </div>
  </div>
</footer>

---
import { business, phoneDigits, hero } from '../data/site.js';

const socialLabels = { facebook: 'Facebook', instagram: 'Instagram', google: 'Google', yelp: 'Yelp' };
const socials = Object.entries(business.social).filter(([, url]) => url);
const year = new Date().getFullYear();
const tel = (p) => `tel:+${phoneDigits(p)}`;
---

<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/img/brand/logo-white.png" alt={business.name} width="477" height="134" loading="lazy" />
      <p>{hero.subheadline}</p>
      {socials.length > 0 && (
        <p class="footer__social">
          {socials.map(([network, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer">{socialLabels[network]}</a>
          ))}
        </p>
      )}
    </div>

    <div>
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href={tel(business.phonePrimary)}>{business.phonePrimary}</a></li>
        <li><a href={tel(business.phoneSecondary)}>{business.phoneSecondary}</a></li>
        <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
        <li><address>{business.street}<br />{business.city}, {business.state} {business.postal}</address></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">Company</h2>
      <ul class="footer__list">
        <li><a href="/services">Services</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/book-now">Book Now</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">Hours</h2>
      <dl class="footer__hours">
        {business.hours.map((h) => (
          <div><dt>{h.days}</dt><dd>{h.time}</dd></div>
        ))}
      </dl>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {business.name}</p>
    <p>{business.tagline}</p>
  </div>
</footer>

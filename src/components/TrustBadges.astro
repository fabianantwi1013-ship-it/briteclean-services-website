---
import Icon from './Icon.astro';
import { trustBadges } from '../data/site.js';
---

<section class="trust" aria-label="Our commitments">
  <ul class="container trust__list">
    {trustBadges.map((badge) => (
      <li><span class="trust__icon" aria-hidden="true"><Icon name={badge.icon} size={16} /></span>{badge.title}</li>
    ))}
  </ul>
</section>

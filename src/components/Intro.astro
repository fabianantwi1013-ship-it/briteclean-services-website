---
/**
 * The opening title sequence: the mark draws itself, the name rises into place, then a
 * light-green line wipes across the screen like a squeegee and takes the curtain with
 * it, revealing the hero.
 *
 * Shown only on the homepage, once per browser session, never under reduced motion,
 * and never without JavaScript — see the inline script in Layout.astro. The CSS keeps
 * it display:none unless <html> has the `intro-on` class.
 */
import { business } from '../data/site.js';
---

<div class="intro" data-intro>
  <div class="intro__curtain grain" data-intro-curtain aria-hidden="true">
    <div class="intro__center">
      <svg class="intro__mark" viewBox="0 0 120 110" fill="none" aria-hidden="true" data-intro-mark>
        <path class="im-stroke" pathLength="1" d="M10 60 60 17l32 27" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
        <path class="im-stroke" pathLength="1" d="M24 52v28" stroke="#fff" stroke-width="7" stroke-linecap="round" />
        <path class="im-stroke" pathLength="1" d="M79 35V21h9v20" stroke="var(--rose)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        <g class="im-window" fill="#fff">
          <rect x="50" y="44" width="8.5" height="8.5" rx="1" />
          <rect x="61" y="44" width="8.5" height="8.5" rx="1" />
          <rect x="50" y="55" width="8.5" height="8.5" rx="1" />
          <rect x="61" y="55" width="8.5" height="8.5" rx="1" />
        </g>
        <path class="im-stroke" pathLength="1" d="M6 80c34 16 74 8 106-30" stroke="var(--rose)" stroke-width="6" stroke-linecap="round" />
        <path class="im-stroke" pathLength="1" d="M14 93c38 14 76 2 98-32" stroke="var(--mint)" stroke-width="6" stroke-linecap="round" />
        <path class="im-spark" d="M101 3l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" fill="var(--rose)" />
        <path class="im-spark" d="M114 30l1.6 4.4 4.4 1.6-4.4 1.6L114 42l-1.6-4.4L108 36l4.4-1.6z" fill="var(--mint)" />
      </svg>

      <p class="intro__word" data-intro-word>Briteclean</p>
      <p class="intro__sub" data-intro-sub>Services LLC</p>
      <p class="intro__tag" data-intro-tag>{business.tagline}</p>
    </div>

    <p class="intro__meta intro__meta--left" data-intro-meta>{business.city}, {business.state}</p>
    <p class="intro__meta intro__meta--right" data-intro-meta><span data-intro-count>000</span></p>
  </div>

  <span class="intro__squeegee" data-intro-squeegee aria-hidden="true"></span>

  <button class="intro__skip" type="button" data-intro-skip>Skip intro</button>
</div>

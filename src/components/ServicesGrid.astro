---
/** Compact services index — used where the full film strip would be too much. */
import Icon from './Icon.astro';
import { services } from '../data/site.js';

interface Props {
  title?: string;
}
const { title = 'Our Cleaning Services' } = Astro.props;
---

<section class="section section--paper" id="services">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 data-split>{title}</h2>
      </div>
      <p class="lead">Homes, offices and commercial spaces — booked around your schedule, cleaned to a standard you can see.</p>
    </div>

    <ul class="svc-index-grid">
      {services.map((service, i) => (
        <li data-reveal>
          <a class="svc-tile" href={`/services#${service.slug}`}>
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <span class="svc-tile__icon" aria-hidden="true"><Icon name={service.icon} size={24} /></span>
            <span class="svc-tile__name">{service.name}</span>
            <span class="svc-tile__text">{service.short}</span>
            <span class="svc-tile__arrow" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

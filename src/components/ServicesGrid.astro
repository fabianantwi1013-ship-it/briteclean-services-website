---
import Img from './Img.astro';
import { services } from '../data/site.js';

interface Props {
  title?: string;
}
const { title = 'Our Services' } = Astro.props;
---

<section class="section" id="services">
  <div class="container">
    <div class="section-head">
      <h2>{title}</h2>
      <a class="link-arrow" href="/services">View all services</a>
    </div>

    <ul class="cards" data-reveal>
      {services.map((service) => (
        <li>
          <a class="card" href={`/services#${service.slug}`}>
            <span class="card__media">
              <Img photo={`service-${service.slug}`} alt="" sizes="(min-width: 1000px) 22vw, (min-width: 600px) 45vw, 50vw" widths={[320, 480, 640]} />
            </span>
            <span class="card__title">{service.name}</span>
            <span class="card__text">{service.short}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

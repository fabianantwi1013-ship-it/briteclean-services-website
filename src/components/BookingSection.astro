---
import Icon from './Icon.astro';
import BookingForm from './BookingForm.astro';
import { business, phoneDigits } from '../data/site.js';

const points = [
  { icon: 'shield', text: 'No payment online' },
  { icon: 'phone', text: 'Confirmed by a real person' },
  { icon: 'leaf', text: 'Supplies included' },
];
---

<section class="section section--tight tint aurora" id="book">
  <div class="container book">
    <ul class="book__points">
      {points.map((p) => (
        <li><span aria-hidden="true"><Icon name={p.icon} size={16} /></span>{p.text}</li>
      ))}
    </ul>
    <BookingForm context="page" />
    <p class="book__call">Prefer to talk? Call <a href={`tel:+${phoneDigits(business.phonePrimary)}`}>{business.phonePrimary}</a></p>
  </div>
</section>

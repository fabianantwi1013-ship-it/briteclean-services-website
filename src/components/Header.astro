---
import Icon from './Icon.astro';
import { business, phoneDigits } from '../data/site.js';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => path === (href.replace(/\/$/, '') || '/');
const tel = (p) => `tel:+${phoneDigits(p)}`;
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <a class="header__brand" href="/" rel="home" aria-label={`${business.name}, home`}>
      <img class="logo logo--white" src="/img/brand/logo-white.png" alt="" width="477" height="134" />
      <img class="logo logo--color" src="/img/brand/logo.webp" alt="" width="420" height="118" />
    </a>

    <nav class="header__nav" aria-label="Primary navigation">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={tel(business.phonePrimary)}>{business.phonePrimary}</a>
      <a class="btn btn--accent btn--sm header__cta" href="/book-now">Book Now</a>

      {/* A link, so the menu still opens without JavaScript (CSS :target). */}
      <a class="menu-toggle" href="#site-menu" role="button" aria-controls="site-menu" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
        <Icon name="menu" size={22} />
      </a>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" data-menu>
  <div class="container menu__top">
    <img class="logo" src="/img/brand/logo-white.png" alt="" width="477" height="134" />
    <a class="menu__close" href="#" aria-label="Close menu" data-menu-close><Icon name="close" size={22} /></a>
  </div>
  <nav class="container menu__nav" aria-label="Main menu">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <a class="btn btn--accent btn--block" href="/book-now">Book Now</a>
    <a class="menu__phone" href={tel(business.phonePrimary)}><Icon name="phone" size={18} /> {business.phonePrimary}</a>
  </nav>
</div>

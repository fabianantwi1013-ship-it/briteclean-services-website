---
/**
 * Service area as a stylised radar map centred on West Chester. Town positions come
 * from approximate coordinates in src/data/site.js, projected onto a flat plane — it
 * is a diagram, not a navigational map, so it is hidden from assistive tech and the
 * same information is given in the text beside it.
 */
import Icon from './Icon.astro';
import { business, areaTowns, whatsappUrl } from '../data/site.js';

const hub = areaTowns.find((t) => t.hub);
const scale = 1750; // px per degree
const cx = 320;
const cy = 300;
const k = Math.cos((hub.lat * Math.PI) / 180);
const towns = areaTowns.map((t) => {
  const x = cx + (t.lng - hub.lng) * k * scale;
  const y = cy - (t.lat - hub.lat) * scale;
  const anchor = t.hub ? 'middle' : x < cx - 40 ? 'end' : 'start';
  const dx = t.hub ? 0 : anchor === 'end' ? -14 : 14;
  const dy = t.hub ? 36 : 5;
  return { ...t, x: +x.toFixed(1), y: +y.toFixed(1), anchor, dx, dy };
});
---

<section class="area section section--paper" id="area">
  <div class="container area__grid">
    <div class="area__copy">
      <p class="eyebrow">Service area</p>
      <h2 data-split>Areas We Serve</h2>
      <p class="lead">{business.serviceArea}</p>
      <p class="muted">Not sure if we reach you? Call or message us — we will tell you straight away.</p>
      <div class="btn-row">
        <a class="btn btn--ink" href="/contact">Contact Us <span class="btn__icon"><Icon name="arrow" size={16} /></span></a>
        <a class="link-line" href={whatsappUrl()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> Ask on WhatsApp</a>
      </div>
    </div>

    <div class="area__map" data-area-map aria-hidden="true">
      <svg viewBox="0 0 640 600" fill="none">
        <defs>
          <radialGradient id="area-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#8DB2FF" stop-opacity=".35" />
            <stop offset="1" stop-color="#8DB2FF" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx={cx} cy={cy} r="270" fill="url(#area-glow)" />
        {[90, 180, 270].map((r) => (
          <circle class="area__ring" cx={cx} cy={cy} r={r} stroke="#1F4FCC" stroke-opacity=".22" stroke-dasharray="2 6" />
        ))}
        <line x1={cx - 290} y1={cy} x2={cx + 290} y2={cy} stroke="#1F4FCC" stroke-opacity=".12" />
        <line x1={cx} y1={cy - 290} x2={cx} y2={cy + 290} stroke="#1F4FCC" stroke-opacity=".12" />
        <g class="area__sweep" style={`transform-origin:${cx}px ${cy}px`}>
          <path d={`M${cx} ${cy} L${cx} ${cy - 270} A270 270 0 0 1 ${cx + 190.9} ${cy - 190.9} Z`} fill="url(#area-glow)" opacity=".8" />
        </g>
        <circle class="area__pulse" cx={cx} cy={cy} r="14" stroke="#FF7A70" stroke-width="2" />
        {towns.filter((t) => !t.hub).map((t) => (
          <line class="area__link" x1={cx} y1={cy} x2={t.x} y2={t.y} stroke="#1F4FCC" stroke-opacity=".35" stroke-width="1" />
        ))}
        {towns.map((t) => (
          <g class={`area__town${t.hub ? ' area__town--hub' : ''}`}>
            <circle cx={t.x} cy={t.y} r={t.hub ? 9 : 6} fill={t.hub ? '#FF7A70' : '#1F4FCC'} stroke="#fff" stroke-width="3" />
            <text x={t.x + t.dx} y={t.y + t.dy} text-anchor={t.anchor}>{t.name}</text>
          </g>
        ))}
      </svg>
      <p class="area__legend index"><span class="area__legend-dot"></span> {business.street}, {business.city}</p>
    </div>
  </div>
</section>

---
import Img from './Img.astro';

interface Props {
  title: string;
  subtitle?: string;
  photo?: string;
  position?: string;
}
const { title, subtitle, photo = 'scene-loft', position } = Astro.props;
---

<section class="page-head">
  <div class="page-head__media" aria-hidden="true">
    <Img photo={photo} alt="" eager sizes="100vw" widths={[640, 960, 1280, 1920]} position={position} />
  </div>
  <div class="container page-head__inner">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

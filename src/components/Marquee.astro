---
/**
 * Decorative ticker of service names. Hidden from assistive tech — the same names are
 * listed, as real links, in the services section immediately after it.
 */
import { services } from '../data/site.js';

const names = services.map((s) => s.name.replace(' Cleaning', ''));
---

<div class="marquee" aria-hidden="true" data-marquee>
  <div class="marquee__track" data-marquee-track>
    {[0, 1].map(() => (
      <div class="marquee__group">
        {names.map((name, i) => (
          <>
            <span class={`marquee__word${i % 2 ? ' marquee__word--outline' : ''}`}>{name}</span>
            <svg class="marquee__spark" viewBox="0 0 24 24" width="40" height="40"><path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z" fill="currentColor" /></svg>
          </>
        ))}
      </div>
    ))}
  </div>
</div>

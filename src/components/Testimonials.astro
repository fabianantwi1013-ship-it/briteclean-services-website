---
/**
 * Reviews as a slideshow, one quote at a time. Without JavaScript all three are shown
 * stacked. The quotes in src/data/site.js are labelled as samples until real reviews
 * replace them.
 */
import Icon from './Icon.astro';
import { testimonials } from '../data/site.js';

const total = String(testimonials.length).padStart(2, '0');
---

<section class="reviews section" id="reviews" data-reviews aria-roledescription="carousel" aria-label="Customer reviews">
  <div class="container reviews__grid">
    <div class="reviews__head">
      <p class="eyebrow">Reviews</p>
      <h2 data-split>What Our Customers Say</h2>

      <div class="reviews__controls" data-reviews-controls>
        <button type="button" class="round-btn" data-reviews-prev aria-label="Previous review"><Icon name="arrowLeft" size={18} /></button>
        <p class="index reviews__count" aria-hidden="true"><span data-reviews-index>01</span> / {total}</p>
        <button type="button" class="round-btn" data-reviews-next aria-label="Next review"><Icon name="arrow" size={18} /></button>
        <button type="button" class="round-btn round-btn--ghost" data-reviews-pause aria-label="Pause reviews">
          <span class="hero__pause-icon hero__pause-icon--pause"><Icon name="pause" size={14} /></span>
          <span class="hero__pause-icon hero__pause-icon--play"><Icon name="play" size={12} /></span>
        </button>
      </div>
    </div>

    <div class="reviews__stage" data-reviews-stage aria-live="off">
      <span class="reviews__mark" aria-hidden="true"><Icon name="quote" size={64} /></span>
      {testimonials.map((t, i) => (
        <div class={`review${i === 0 ? ' is-active' : ''}`} data-review role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
          <figure class="review__figure">
          <div class="review__stars">
            <span aria-hidden="true">{'★'.repeat(Math.max(0, Math.min(5, t.rating)))}</span>
            <span class="sr-only">Rated {t.rating} out of 5</span>
          </div>
          <blockquote class="review__quote" data-review-quote>{t.quote}</blockquote>
          <figcaption class="review__author">
            <span class="review__name">{t.author}</span>
            <span class="review__place">{t.location}</span>
          </figcaption>
          </figure>
        </div>
      ))}
      <div class="reviews__timer" aria-hidden="true"><span data-reviews-timer></span></div>
    </div>
  </div>
</section>

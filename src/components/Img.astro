---
/**
 * Responsive photo: AVIF and WebP at a few widths, with the JPEG as the fallback.
 * `photo` is a key from src/data/photos.js.
 */
import { Picture } from 'astro:assets';
import { photos } from '../data/photos.js';

interface Props {
  photo: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** Load after everything else (e.g. slideshow frames that are not shown yet). */
  lowPriority?: boolean;
  position?: string;
  class?: string;
  /** Pass an empty string for purely decorative uses. */
  alt?: string;
}

const {
  photo,
  sizes = '100vw',
  widths = [640, 960, 1280],
  eager = false,
  lowPriority = false,
  position,
  class: className,
  alt,
} = Astro.props;

const entry = photos[photo];
if (!entry) throw new Error(`Unknown photo key: ${photo}`);

const usable = widths.filter((w) => w <= entry.src.width);
---

<Picture
  src={entry.src}
  alt={alt ?? entry.alt}
  formats={['avif', 'webp']}
  widths={usable.length ? usable : [entry.src.width]}
  sizes={sizes}
  quality={62}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : lowPriority ? 'low' : undefined}
  decoding="async"
  class={className}
  style={position ? `object-position:${position}` : undefined}
  pictureAttributes={{ class: 'pic' }}
/>

---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Intro from '../components/Intro.astro';
import Schema from '../components/Schema.astro';
import { business } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  /** Path to an OG image, relative to the site root. */
  image?: string;
  /** Set on the homepage, where the title should not be suffixed. */
  bare?: boolean;
  /** Play the opening title sequence (homepage). */
  intro?: boolean;
}

const { title, description, image = '/img/og.jpg', bare = false, intro = false } = Astro.props;

const fullTitle = bare ? title : `${title} | ${business.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en" data-page={intro ? 'home' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A1830" />

    {/*
      Runs before first paint. `js` lets below-the-fold sections fade in; `intro`
      plays the homepage title sequence once per session (never under reduced
      motion). The class is removed after 2.6s whatever happens.
    */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (d.getAttribute('data-page') === 'home' && !sessionStorage.getItem('bc-intro') &&
              !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sessionStorage.setItem('bc-intro', '1');
            d.classList.add('intro-on', 'intro-played');
            window.__bcIntroEnd = setTimeout(function () { d.classList.remove('intro-on'); }, 2600);
          }
        } catch (e) {}
      })();
    </script>

    <Font cssVariable="--font-sans-family" preload />

    <link rel="icon" type="image/png" href="/img/brand/site-icon.png" />
    <link rel="apple-touch-icon" href="/img/brand/site-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <Schema />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    {intro && <Intro />}

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>

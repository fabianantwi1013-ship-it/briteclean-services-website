---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import ServiceArea from '../components/ServiceArea.astro';
import { business, phoneDigits, whatsappUrl, addressLine } from '../data/site.js';

const mapQuery = `${business.street}, ${business.city}, ${business.stateShort} ${business.postal}`;
// Google's keyless embed — no API key, no billing account, no third-party script.
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
---

<Layout
  title="Contact Us"
  description={`Call or WhatsApp ${business.phonePrimary}. ${business.name} is based at ${addressLine()}.`}
>
  <PageHead title="Contact" subtitle="Call, message, or send us a note — whichever suits you." />

  <section class="bc-section">
    <div class="bc-container bc-contact-grid">
      <div>
        <h2>Talk to us</h2>
        <ul class="bc-contact-list">
          <li>
            <span class="bc-medallion bc-medallion--sm" aria-hidden="true"><Icon name="phone" size={18} /></span>
            <div>
              <span class="bc-contact-list__label">Call or WhatsApp</span>
              <a href={`tel:+${phoneDigits(business.phonePrimary)}`}>{business.phonePrimary}</a><br />
              <a href={`tel:+${phoneDigits(business.phoneSecondary)}`}>{business.phoneSecondary}</a>
            </div>
          </li>
          <li>
            <span class="bc-medallion bc-medallion--sm" aria-hidden="true"><Icon name="mail" size={18} /></span>
            <div>
              <span class="bc-contact-list__label">Email</span>
              <a href={`mailto:${business.email}`}>{business.email}</a>
            </div>
          </li>
          <li>
            <span class="bc-medallion bc-medallion--sm" aria-hidden="true"><Icon name="pin" size={18} /></span>
            <div>
              <span class="bc-contact-list__label">Address</span>
              <address style="font-style:normal">
                {business.street}<br />{business.city}, {business.state} {business.postal}
              </address>
            </div>
          </li>
          <li>
            <span class="bc-medallion bc-medallion--sm" aria-hidden="true"><Icon name="clock" size={18} /></span>
            <div>
              <span class="bc-contact-list__label">Hours</span>
              <dl class="bc-footer__hours" style="color:var(--bc-body)">
                {business.hours.map((h) => (
                  <div><dt>{h.days}</dt><dd style="color:var(--bc-muted)">{h.time}</dd></div>
                ))}
              </dl>
            </div>
          </li>
        </ul>

        <div class="bc-btn-row" style="margin-top:28px">
          <a class="bc-btn bc-btn--whatsapp" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />
            Message on WhatsApp
          </a>
          <a class="bc-btn bc-btn--primary" href="/book-now">Book a cleaning</a>
        </div>
      </div>

      <div>
        <div class="bc-map">
          <iframe
            src={mapSrc}
            title={`Map showing ${mapQuery}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <div style="margin-top:32px">
          <h2>Send a message</h2>
          <p style="color:var(--bc-muted)">
            For a full booking, use the Book Now form — it captures everything we need in one go.
          </p>

          <div class="bc-alert bc-alert--success" role="status" id="bc-contact-success" hidden>
            <strong>Message sent.</strong>
            <p>Thanks for getting in touch — we will reply as soon as we can.</p>
          </div>

          <div class="bc-alert bc-alert--error" role="alert" id="bc-contact-error" hidden></div>

          <form class="bc-form bc-form--contact" id="bc-contact-form" method="POST" action="/api/contact">
            <div class="bc-hp" aria-hidden="true">
              <label for="bc-contact-website">Leave this field empty</label>
              <input type="text" id="bc-contact-website" name="website" value="" tabindex="-1" autocomplete="off" />
            </div>

            <div class="bc-field">
              <label class="bc-label" for="bc-contact-name">
                Your name <span class="bc-req" aria-hidden="true">*</span>
                <span class="screen-reader-text">(required)</span>
              </label>
              <input class="bc-input" type="text" id="bc-contact-name" name="name" autocomplete="name" maxlength="120" required />
            </div>

            <div class="bc-field">
              <label class="bc-label" for="bc-contact-email">
                Email address <span class="bc-req" aria-hidden="true">*</span>
                <span class="screen-reader-text">(required)</span>
              </label>
              <input class="bc-input" type="email" id="bc-contact-email" name="email" autocomplete="email" maxlength="190" required />
            </div>

            <div class="bc-field">
              <label class="bc-label" for="bc-contact-phone">Phone (optional)</label>
              <input class="bc-input" type="tel" id="bc-contact-phone" name="phone" autocomplete="tel" maxlength="40" />
            </div>

            <div class="bc-field">
              <label class="bc-label" for="bc-contact-message">
                Message <span class="bc-req" aria-hidden="true">*</span>
                <span class="screen-reader-text">(required)</span>
              </label>
              <textarea class="bc-input" id="bc-contact-message" name="message" rows="5" maxlength="2000" required></textarea>
            </div>

            <button type="submit" class="bc-btn bc-btn--primary bc-btn--block">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <ServiceArea />
</Layout>

<script>
  const form = document.getElementById('bc-contact-form');
  const ok = document.getElementById('bc-contact-success');
  const bad = document.getElementById('bc-contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';
    bad.hidden = true;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      const result = await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        form.hidden = true;
        ok.hidden = false;
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      bad.textContent = result.message || 'Please fill in your name, a valid email address and a message.';
      bad.hidden = false;
    } catch {
      bad.textContent = 'We could not send that — please check your connection, or call us instead.';
      bad.hidden = false;
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>

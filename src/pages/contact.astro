---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { business, phoneDigits, whatsappUrl, addressLine } from '../data/site.js';

const mapQuery = `${business.street}, ${business.city}, ${business.stateShort} ${business.postal}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;
const tel = (p) => `tel:+${phoneDigits(p)}`;
---

<Layout
  title="Contact Us"
  description={`Call or WhatsApp ${business.phonePrimary}. ${business.name}, ${addressLine()}.`}
>
  <PageHead title="Contact Us" subtitle="Call, WhatsApp or send a message." photo="scene-bath" />

  <section class="section tint aurora">
    <div class="container contact">
      <div class="contact__info" data-reveal>
        <ul class="contact__list">
          <li>
            <span class="contact__icon" aria-hidden="true"><Icon name="phone" size={18} /></span>
            <div>
              <p class="contact__label">Phone or WhatsApp</p>
              <a href={tel(business.phonePrimary)}>{business.phonePrimary}</a><br />
              <a href={tel(business.phoneSecondary)}>{business.phoneSecondary}</a>
            </div>
          </li>
          <li>
            <span class="contact__icon" aria-hidden="true"><Icon name="mail" size={18} /></span>
            <div>
              <p class="contact__label">Email</p>
              <a href={`mailto:${business.email}`}>{business.email}</a>
            </div>
          </li>
          <li>
            <span class="contact__icon" aria-hidden="true"><Icon name="pin" size={18} /></span>
            <div>
              <p class="contact__label">Address</p>
              <address>{business.street}<br />{business.city}, {business.state} {business.postal}</address>
              <a class="link-arrow" href={directions} target="_blank" rel="noopener noreferrer">Get directions</a>
            </div>
          </li>
          <li>
            <span class="contact__icon" aria-hidden="true"><Icon name="clock" size={18} /></span>
            <div>
              <p class="contact__label">Hours</p>
              <dl class="contact__hours">
                {business.hours.map((h) => (
                  <div><dt>{h.days}</dt><dd>{h.time}</dd></div>
                ))}
              </dl>
            </div>
          </li>
        </ul>
        <a class="btn btn--whatsapp" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} /> Message on WhatsApp
        </a>
        <p class="contact__area"><strong>Areas we serve:</strong> {business.serviceArea}</p>
      </div>

      <div class="contact__form" data-reveal>
        <h2>Send a Message</h2>

        <div class="bc-alert bc-alert--success" role="status" id="bc-contact-success" hidden>
          <strong>Message sent.</strong>
          <p>Thanks for getting in touch. We will reply soon.</p>
        </div>

        <div class="bc-alert bc-alert--error" role="alert" id="bc-contact-error" hidden></div>

        <form class="bc-form bc-form--contact" id="bc-contact-form" method="POST" action="/api/contact">
          <div class="bc-hp" aria-hidden="true">
            <label for="bc-contact-website">Leave this field empty</label>
            <input type="text" id="bc-contact-website" name="website" value="" tabindex="-1" autocomplete="off" />
          </div>

          <div class="bc-form__row">
            <div class="bc-field">
              <label class="bc-label" for="bc-contact-name">Name <span class="bc-req" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
              <input class="bc-input" type="text" id="bc-contact-name" name="name" autocomplete="name" maxlength="120" required />
            </div>
            <div class="bc-field">
              <label class="bc-label" for="bc-contact-email">Email <span class="bc-req" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
              <input class="bc-input" type="email" id="bc-contact-email" name="email" autocomplete="email" maxlength="190" required />
            </div>
          </div>

          <div class="bc-field">
            <label class="bc-label" for="bc-contact-phone">Phone (optional)</label>
            <input class="bc-input" type="tel" id="bc-contact-phone" name="phone" autocomplete="tel" maxlength="40" />
          </div>

          <div class="bc-field">
            <label class="bc-label" for="bc-contact-message">Message <span class="bc-req" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
            <textarea class="bc-input" id="bc-contact-message" name="message" rows="5" maxlength="2000" required></textarea>
          </div>

          <button type="submit" class="btn btn--lg btn--block">Send Message</button>
        </form>
        <p class="contact__note">Want to book? Use our <a href="/book-now">booking form</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('bc-contact-form');
  const ok = document.getElementById('bc-contact-success');
  const bad = document.getElementById('bc-contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';
    bad.hidden = true;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      const result = await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        form.hidden = true;
        ok.hidden = false;
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      bad.textContent = result.message || 'Please enter your name, a valid email and a message.';
      bad.hidden = false;
    } catch {
      bad.textContent = 'We could not send that. Please check your connection, or call us.';
      bad.hidden = false;
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>

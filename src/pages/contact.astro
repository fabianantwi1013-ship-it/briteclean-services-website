---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import ServiceArea from '../components/ServiceArea.astro';
import { business, phoneDigits, whatsappUrl, addressLine } from '../data/site.js';

const mapQuery = `${business.street}, ${business.city}, ${business.stateShort} ${business.postal}`;
// Google's keyless embed — no API key, no billing account, no third-party script.
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;
const tel = (p) => `tel:+${phoneDigits(p)}`;
---

<Layout
  title="Contact Us"
  description={`Call or WhatsApp ${business.phonePrimary}. ${business.name} is based at ${addressLine()}.`}
>
  <PageHead title="Contact" eyebrow="Talk to us" subtitle="Call, message, or send us a note — whichever suits you." photo="scene-bath" compact />

  <section class="section contact">
    <div class="container">
      <ul class="channels">
        <li class="channel channel--primary" data-reveal>
          <span class="channel__icon" aria-hidden="true"><Icon name="phone" size={22} /></span>
          <p class="index">Call or WhatsApp</p>
          <a class="channel__value" href={tel(business.phonePrimary)}>{business.phonePrimary}</a>
          <a class="channel__value channel__value--sub" href={tel(business.phoneSecondary)}>{business.phoneSecondary}</a>
        </li>
        <li class="channel" data-reveal>
          <span class="channel__icon" aria-hidden="true"><Icon name="whatsapp" size={22} /></span>
          <p class="index">WhatsApp</p>
          <a class="channel__value" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Message on WhatsApp</a>
          <p class="channel__note">The fastest way to reach us.</p>
        </li>
        <li class="channel" data-reveal>
          <span class="channel__icon" aria-hidden="true"><Icon name="mail" size={22} /></span>
          <p class="index">Email</p>
          <a class="channel__value channel__value--email" href={`mailto:${business.email}`}>{business.email}</a>
        </li>
        <li class="channel" data-reveal>
          <span class="channel__icon" aria-hidden="true"><Icon name="pin" size={22} /></span>
          <p class="index">Address</p>
          <address class="channel__value channel__value--text">{business.street}<br />{business.city}, {business.state} {business.postal}</address>
          <a class="link-line channel__link" href={directions} target="_blank" rel="noopener noreferrer">Get directions <Icon name="arrowUpRight" size={14} /></a>
        </li>
      </ul>

      <div class="contact__grid">
        <div class="contact__form-col">
          <p class="eyebrow">Send a message</p>
          <h2 data-split>Drop us a <em>line</em></h2>
          <p class="muted">For a full booking, use the Book Now form — it captures everything we need in one go.</p>

          <div class="bc-alert bc-alert--success" role="status" id="bc-contact-success" hidden>
            <strong>Message sent.</strong>
            <p>Thanks for getting in touch — we will reply as soon as we can.</p>
          </div>

          <div class="bc-alert bc-alert--error" role="alert" id="bc-contact-error" hidden></div>

          <form class="bc-form bc-form--contact" id="bc-contact-form" method="POST" action="/api/contact">
            <div class="bc-hp" aria-hidden="true">
              <label for="bc-contact-website">Leave this field empty</label>
              <input type="text" id="bc-contact-website" name="website" value="" tabindex="-1" autocomplete="off" />
            </div>

            <div class="bc-form__row">
              <div class="bc-field">
                <label class="bc-label" for="bc-contact-name">
                  Your name <span class="bc-req" aria-hidden="true">*</span>
                  <span class="sr-only">(required)</span>
                </label>
                <input class="bc-input" type="text" id="bc-contact-name" name="name" autocomplete="name" maxlength="120" required />
              </div>

              <div class="bc-field">
                <label class="bc-label" for="bc-contact-email">
                  Email address <span class="bc-req" aria-hidden="true">*</span>
                  <span class="sr-only">(required)</span>
                </label>
                <input class="bc-input" type="email" id="bc-contact-email" name="email" autocomplete="email" maxlength="190" required />
              </div>
            </div>

            <div class="bc-field">
              <label class="bc-label" for="bc-contact-phone">Phone (optional)</label>
              <input class="bc-input" type="tel" id="bc-contact-phone" name="phone" autocomplete="tel" maxlength="40" />
            </div>

            <div class="bc-field">
              <label class="bc-label" for="bc-contact-message">
                Message <span class="bc-req" aria-hidden="true">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <textarea class="bc-input" id="bc-contact-message" name="message" rows="5" maxlength="2000" required></textarea>
            </div>

            <button type="submit" class="btn btn--ink btn--lg btn--block">Send Message</button>
          </form>
        </div>

        <div class="contact__side">
          <div class="map-frame reveal-frame" data-reveal-img>
            <iframe
              src={mapSrc}
              title={`Map showing ${mapQuery}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>

          <div class="hours-card">
            <p class="index">Opening hours</p>
            <dl>
              {business.hours.map((h) => (
                <div><dt>{h.days}</dt><dd>{h.time}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ServiceArea />
</Layout>

<script>
  const form = document.getElementById('bc-contact-form');
  const ok = document.getElementById('bc-contact-success');
  const bad = document.getElementById('bc-contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';
    bad.hidden = true;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      const result = await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        form.hidden = true;
        ok.hidden = false;
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      bad.textContent = result.message || 'Please fill in your name, a valid email address and a message.';
      bad.hidden = false;
    } catch {
      bad.textContent = 'We could not send that — please check your connection, or call us instead.';
      bad.hidden = false;
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>

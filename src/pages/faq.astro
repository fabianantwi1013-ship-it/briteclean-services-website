---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { faqs, business, phoneDigits } from '../data/site.js';

// FAQPage structured data, eligible for expanded results in Google.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="FAQ"
  description="Answers about booking, payment, access, supplies and our satisfaction guarantee."
>
  <PageHead title="FAQ" subtitle="Quick answers to common questions." photo="scene-kitchen" />

  <section class="section tint aurora">
    <div class="container container--narrow" data-reveal>
      <div class="faq">
        {faqs.map((faq) => (
          <details class="faq__item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
      <p class="faq__more">
        Still have a question? Call <a href={`tel:+${phoneDigits(business.phonePrimary)}`}>{business.phonePrimary}</a>
        or <a href="/contact">send us a message</a>.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

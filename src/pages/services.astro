---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site.js';
---

<Layout
  title="Cleaning Services"
  description="Residential, office, deep, commercial, window, move-in, general and emergency cleaning in West Chester, Ohio and nearby areas."
>
  <PageHead title="Our Services" subtitle="Homes, offices and commercial spaces." photo="scene-loft" />

  <section class="section tint aurora">
    <div class="container services-list">
      {services.map((service, i) => (
        <article class={`service service--${i % 3}`} id={service.slug}>
          <div class="service__media" data-reveal="image">
            <Img photo={`service-${service.slug}`} sizes="(min-width: 800px) 40vw, 92vw" widths={[480, 720, 960]} />
          </div>
          <div class="service__body" data-reveal>
            <span class="service__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="service__icon" aria-hidden="true"><Icon name={service.icon} size={20} /></span>
            <h2>{service.name}</h2>
            <p>{service.long}</p>
            <a class="btn" href={`/book-now?service=${service.slug}`}>Book this service</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand photo="scene-bath" />
</Layout>

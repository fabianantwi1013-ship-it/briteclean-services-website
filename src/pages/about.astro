---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site.js';
import alts from '../data/photo-alt.json';
---

<Layout
  title="About Us"
  description={`${business.name} is a cleaning company serving ${business.city}, ${business.state}. Background-checked staff, eco-friendly products and a written scope for every job.`}
>
  <PageHead title="About" subtitle="A local cleaning company built on showing up." />

  <section class="bc-section">
    <div class="bc-container bc-contact-grid">
      <div>
        <img
          src="/img/photos/about-team.jpg"
          alt={alts['about-team.jpg']}
          width="1600" height="1000" loading="lazy" decoding="async"
          style="border-radius:var(--bc-radius-lg)"
        />
      </div>

      <div>
        <span class="bc-eyebrow">Our story</span>
        <div class="bc-content">
          <h2>A local cleaning company built on showing up</h2>
          <p>
            {business.name} is a cleaning company serving {business.city}, {business.state} and the surrounding
            communities. We started with a simple observation: most people do not want to manage a cleaning
            service. They want to agree a time, come home to a clean space, and not think about it again.
          </p>
          <p>
            So that is what we built. Background-checked staff who are trained the same way and turn up when
            they said they would. Eco-friendly products that are safe around children and pets. A written scope
            for every job, so nobody is guessing what "clean" means. And a real person on the other end of the
            phone when something needs changing.
          </p>
          <p>
            We are not the biggest cleaning company in the area, and we are not trying to be. We would rather
            keep the customers we have by doing the work properly than grow past the point where we can.
          </p>
          <p style="padding:14px 18px;background:var(--bc-bg-tint);border-radius:var(--bc-radius-sm);font-size:.9rem;color:var(--bc-muted)">
            <strong>Placeholder copy.</strong> Replace this with the real company story — edit
            <code>src/pages/about.astro</code>.
          </p>
        </div>

        <p class="bc-gold-text" style="color:var(--bc-red);margin-top:1em">{business.tagline}</p>
      </div>
    </div>
  </section>

  <WhyChooseUs />
  <Testimonials />
  <CtaBand />
</Layout>

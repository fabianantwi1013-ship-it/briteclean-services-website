---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Img from '../components/Img.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site.js';
---

<Layout
  title="About Us"
  description={`${business.name} is a cleaning company in ${business.city}, ${business.state}, serving homes, offices and commercial spaces.`}
>
  <PageHead title="About Us" subtitle={business.tagline} photo="scene-light" position="50% 40%" />

  <section class="section">
    <div class="container split" data-reveal>
      <div class="split__text">
        <h2>{business.taglineSecondary}</h2>
        <p>
          {business.name} is a cleaning company based in {business.city}, {business.state}. We clean homes,
          offices and commercial spaces across the area.
        </p>
        <p>
          Our team is trained, background-checked and courteous. We use eco-friendly products, bring
          everything we need, and work around your schedule.
        </p>
        <a class="btn" href="/book-now">Book a Cleaning</a>
      </div>
      <div class="split__media">
        <Img photo="about-team" sizes="(min-width: 900px) 45vw, 92vw" widths={[640, 960, 1280]} />
      </div>
    </div>
  </section>

  <WhyChooseUs />
  <CtaBand photo="scene-living" />
</Layout>
